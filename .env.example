# Copy to .env for running the app/tests outside Docker: cp .env.example .env
DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger
ENVIRONMENT=local
LOG_LEVEL=INFO
# Human-readable logs locally; Docker/production use JSON.
LOG_JSON=false
# The compose Redis is published on 6380 (not 6379) to avoid clashing with a local Redis.
REDIS_URL=redis://localhost:6380/0
